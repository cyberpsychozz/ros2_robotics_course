<?xml version="1.0" encoding="utf-8"?>
<robot name="ackerman_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="wheelbase" value="0.8"/>
  <xacro:property name="track" value="0.62"/>
  <xacro:property name="wheel_radius" value="0.12"/>
  <xacro:property name="wheel_width" value="0.07"/>
  <xacro:property name="sensor_x" value="0.28"/>
  <xacro:property name="sensor_z" value="0.38"/>
  <!-- URDF requires a steering velocity limit; the SDF does not specify one.
       This configurable 1 rad/s default is a modeling assumption. -->
  <xacro:arg name="steering_velocity" default="1.0"/>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="12.0"/>
      <inertia ixx="0.55" ixy="0" ixz="0"
               iyy="1.10" iyz="0" izz="1.40"/>
    </inertial>

    <visual name="body_visual">
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="1.05 0.52 0.22"/>
      </geometry>
      <material name="body_blue">
        <color rgba="0.05 0.36 0.72 1"/>
      </material>
    </visual>

    <collision name="body_collision">
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="1.05 0.52 0.22"/>
      </geometry>
    </collision>
  </link>

  <link name="front_left_knuckle">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <link name="front_right_knuckle">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Wheel link frames stay aligned with their parents at zero joint angle.
       Rotate geometry and the original SDF inertia frame about X by pi/2.
       Wheel joints can therefore rotate about their local Y axis. -->

  <link name="front_left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.006" ixy="0" ixz="0"
               iyy="0.003" iyz="0" izz="0.006"/>
    </inertial>

    <visual name="visual">
      <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.04 0.04 0.04 1"/>
      </material>
    </visual>

    <collision name="collision">
      <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
  </link>

  <link name="front_right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.006" ixy="0" ixz="0"
               iyy="0.003" iyz="0" izz="0.006"/>
    </inertial>

    <visual name="visual">
      <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.04 0.04 0.04 1"/>
      </material>
    </visual>

    <collision name="collision">
      <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
  </link>

  <link name="rear_left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.006" ixy="0" ixz="0"
               iyy="0.003" iyz="0" izz="0.006"/>
    </inertial>

    <visual name="visual">
      <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.04 0.04 0.04 1"/>
      </material>
    </visual>

    <collision name="collision">
      <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
  </link>

  <link name="rear_right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.006" ixy="0" ixz="0"
               iyy="0.003" iyz="0" izz="0.006"/>
    </inertial>

    <visual name="visual">
      <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.04 0.04 0.04 1"/>
      </material>
    </visual>

    <collision name="collision">
      <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
  </link>

  <link name="camera_link">
    <inertial>
      <mass value="0.033333333333"/>
      <inertia ixx="0.000333333333" ixy="0" ixz="0"
               iyy="0.000333333333" iyz="0" izz="0.000333333333"/>
    </inertial>
  </link>

  <link name="lidar_link">
    <inertial>
      <mass value="0.033333333333"/>
      <inertia ixx="0.000333333333" ixy="0" ixz="0"
               iyy="0.000333333333" iyz="0" izz="0.000333333333"/>
    </inertial>
  </link>

  <link name="imu_link">
    <inertial>
      <mass value="0.033333333334"/>
      <inertia ixx="0.000333333334" ixy="0" ixz="0"
               iyy="0.000333333334" iyz="0" izz="0.000333333334"/>
    </inertial>
  </link>

  <!-- Joint origins locate child frames relative to their parents at q=0. -->
  <joint name="front_left_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_knuckle"/>
    <origin xyz="${wheelbase / 2} ${track / 2} 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.55" upper="0.55" effort="25"
           velocity="$(arg steering_velocity)"/>
  </joint>

  <joint name="front_right_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_knuckle"/>
    <origin xyz="${wheelbase / 2} -${track / 2} 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.55" upper="0.55" effort="25"
           velocity="$(arg steering_velocity)"/>
  </joint>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_knuckle"/>
    <child link="front_left_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_knuckle"/>
    <child link="front_right_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-${wheelbase / 2} ${track / 2} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-${wheelbase / 2} -${track / 2} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${sensor_x} 0 ${sensor_z}" rpy="0 0 0"/>
  </joint>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${sensor_x} 0 ${sensor_z}" rpy="0 0 0"/>
  </joint>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${sensor_x} 0 ${sensor_z}" rpy="0 0 0"/>
  </joint>

</robot>
