<?xml version="1.0"?>
<package format="3">
  <name>course_bringup</name>
  <version>0.0.0</version>
  <description>Launch turtlesim, patrol, pose relay, QoS subscriber, and optional recording.</description>
  <maintainer email="nik631stal@mail.ru">cyberpsychoz</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>patrol</exec_depend>
  <exec_depend>turtlesim</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend condition="$ROS_DISTRO == 'lyrical' or $ROS_DISTRO == 'rolling'">turtlesim_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_mypy</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>ament_xmllint</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
